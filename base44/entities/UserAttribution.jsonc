{
  "name": "UserAttribution",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID of the user who answered the survey"
    },
    "source": {
      "type": "string",
      "enum": [
        "ad",
        "influencer",
        "friend_recommendation"
      ],
      "description": "ad = Publicite Story221, influencer = via an influencer card, friend_recommendation = recommandation d'un ami"
    },
    "network": {
      "type": "string",
      "enum": [
        "facebook",
        "instagram",
        "tiktok",
        "snapchat",
        "youtube"
      ],
      "description": "Social network chosen in Q1 (not set for friend_recommendation)"
    },
    "influencer_id": {
      "type": "string",
      "description": "MarketingInfluencer ID when source=influencer"
    },
    "influencer_name": {
      "type": "string",
      "description": "Snapshot of influencer name for admin display"
    },
    "country": {
      "type": "string"
    },
    "user_email": {
      "type": "string",
      "description": "Snapshot of user email for admin search"
    },
    "user_username": {
      "type": "string",
      "description": "Snapshot of username for admin display"
    }
  },
  "required": [
    "user_id",
    "source"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}