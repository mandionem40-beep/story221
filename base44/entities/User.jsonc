{
  "name": "User",
  "type": "object",
  "properties": {
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "phone_country": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "account_status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "banned"
      ],
      "default": "active"
    },
    "diamonds": {
      "type": "integer",
      "default": 0
    },
    "free_trial_used": {
      "type": "boolean",
      "default": false
    },
    "referral_code": {
      "type": "string"
    },
    "referred_by": {
      "type": "string"
    },
    "referral_rewarded": {
      "type": "boolean",
      "default": false
    }
  }
}