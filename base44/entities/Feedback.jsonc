{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "app_rating": {
      "type": "integer",
      "default": 0
    },
    "video_quality_rating": {
      "type": "integer",
      "default": 0
    },
    "speed_rating": {
      "type": "integer",
      "default": 0
    },
    "ux_rating": {
      "type": "integer",
      "default": 0
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "app_rating"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}