{
  "name": "SocialLink",
  "type": "object",
  "properties": {
    "platform": {
      "type": "string",
      "enum": [
        "tiktok",
        "instagram",
        "youtube",
        "facebook",
        "x",
        "linkedin"
      ]
    },
    "label": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "platform",
    "url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}