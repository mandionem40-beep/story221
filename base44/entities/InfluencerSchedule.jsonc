{
  "name": "InfluencerSchedule",
  "type": "object",
  "properties": {
    "influencer_id": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "published",
        "cancelled"
      ],
      "default": "pending"
    },
    "topic": {
      "type": "string"
    },
    "topic_description": {
      "type": "string"
    },
    "generation_id": {
      "type": "string"
    },
    "duration_minutes": {
      "type": "number"
    },
    "format": {
      "type": "string"
    },
    "music": {
      "type": "string"
    }
  },
  "required": [
    "influencer_id",
    "scheduled_date",
    "topic"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}