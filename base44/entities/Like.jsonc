{
  "name": "Like",
  "type": "object",
  "properties": {
    "reel_id": {
      "type": "string"
    }
  },
  "required": [
    "reel_id"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}