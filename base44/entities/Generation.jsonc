{
  "name": "Generation",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "film",
        "serie",
        "anime",
        "cartoon",
        "ad",
        "storyboard",
        "story",
        "music_clip",
        "voice",
        "character",
        "influencer"
      ],
      "default": "video"
    },
    "title": {
      "type": "string"
    },
    "synopsis": {
      "type": "string"
    },
    "prompt": {
      "type": "string"
    },
    "enhanced_script": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "camera_angle": {
            "type": "string"
          },
          "camera_movement": {
            "type": "string"
          },
          "lighting": {
            "type": "string"
          },
          "color_grade": {
            "type": "string"
          },
          "duration_seconds": {
            "type": "integer"
          },
          "dialogue": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          },
          "transition": {
            "type": "string"
          }
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "appearance": {
            "type": "string"
          },
          "voice": {
            "type": "string"
          },
          "personality": {
            "type": "string"
          },
          "clothing": {
            "type": "string"
          },
          "age": {
            "type": "string"
          },
          "emotions": {
            "type": "string"
          },
          "speech_style": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "storyboard": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "shot": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "visual": {
            "type": "string"
          }
        }
      }
    },
    "dialogues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene": {
            "type": "string"
          },
          "character": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "emotion": {
            "type": "string"
          }
        }
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "continuity_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "pipeline_step": {
      "type": "string"
    },
    "cost_diamonds": {
      "type": "integer",
      "default": 0
    },
    "duration_minutes": {
      "type": "integer",
      "default": 1
    },
    "language": {
      "type": "string",
      "default": "Fran\u00e7ais"
    },
    "style": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "music": {
      "type": "string"
    },
    "resolution": {
      "type": "string"
    },
    "result_url": {
      "type": "string"
    },
    "voice_url": {
      "type": "string"
    },
    "result_type": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "audio",
        "text"
      ]
    },
    "ad_sector": {
      "type": "string"
    },
    "ad_brand_name": {
      "type": "string"
    },
    "ad_logo_url": {
      "type": "string"
    },
    "ad_message": {
      "type": "string"
    },
    "ad_colors": {
      "type": "string"
    },
    "ad_concept": {
      "type": "string"
    },
    "ad_slogan": {
      "type": "string"
    },
    "ad_cta": {
      "type": "string"
    },
    "ad_private_use": {
      "type": "boolean",
      "default": false
    },
    "is_published": {
      "type": "boolean",
      "default": false
    },
    "reel_id": {
      "type": "string"
    },
    "reference_images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "type",
    "prompt"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}