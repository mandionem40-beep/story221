{
  "name": "UserCreativeProfile",
  "type": "object",
  "properties": {
    "preferred_styles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Styles the user repeatedly requests or rates highly"
    },
    "preferred_languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preferred_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recurring_corrections": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Correction patterns observed for this user (to avoid repeating)"
    },
    "preferences_summary": {
      "type": "string",
      "description": "Claude-readable summary of the user's creative taste"
    },
    "avg_rating": {
      "type": "number",
      "default": 0
    },
    "total_ratings": {
      "type": "integer",
      "default": 0
    },
    "total_generations": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}