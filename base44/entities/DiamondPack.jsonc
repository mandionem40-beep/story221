{
  "name": "DiamondPack",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "diamonds": {
      "type": "integer"
    },
    "price_fcfa": {
      "type": "integer"
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "display_order": {
      "type": "integer",
      "default": 0
    }
  },
  "required": [
    "name",
    "diamonds",
    "price_fcfa"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}