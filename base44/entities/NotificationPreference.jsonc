{
  "name": "NotificationPreference",
  "type": "object",
  "properties": {
    "notification_type": {
      "type": "string",
      "enum": [
        "like",
        "comment",
        "follow",
        "diamonds",
        "influencer_published",
        "performance",
        "moderation"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "notification_type"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}