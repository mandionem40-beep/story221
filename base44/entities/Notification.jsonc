{
  "name": "Notification",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "like",
        "comment",
        "reply",
        "follow",
        "diamonds",
        "influencer_published",
        "performance",
        "moderation",
        "referral_signup",
        "referral_published",
        "referral_reward",
        "system"
      ],
      "default": "system"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "data": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "source_user_id": {
      "type": "string"
    },
    "reel_id": {
      "type": "string"
    },
    "grouped_count": {
      "type": "integer",
      "default": 1
    }
  },
  "required": [
    "title",
    "type",
    "recipient_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "data.recipient_id": "{{user.id}}"
    }
  }
}