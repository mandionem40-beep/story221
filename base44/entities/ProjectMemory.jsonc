{
  "name": "ProjectMemory",
  "type": "object",
  "properties": {
    "project_key": {
      "type": "string",
      "description": "Stable key grouping a series/project (series_id, influencer_id, or user-defined slug)"
    },
    "title": {
      "type": "string"
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Character identity descriptions to preserve across episodes"
    },
    "places": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Recurring decor/place descriptions"
    },
    "style": {
      "type": "string"
    },
    "palette": {
      "type": "string"
    },
    "timeline": {
      "type": "string",
      "description": "Chronology / episode order notes"
    },
    "continuity_notes": {
      "type": "string"
    },
    "creative_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Rationale for past creative choices"
    },
    "last_generation_id": {
      "type": "string"
    }
  },
  "required": [
    "project_key"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}