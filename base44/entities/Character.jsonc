{
  "name": "Character",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "appearance": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "age": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "clothing": {
      "type": "string"
    },
    "emotions": {
      "type": "string"
    },
    "speech_style": {
      "type": "string"
    },
    "reference_image_url": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}