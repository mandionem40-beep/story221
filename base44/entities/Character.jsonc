{
  "name": "Character",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "appearance": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "animal",
        "fruit",
        "person",
        "object",
        "vehicle",
        "place",
        "creature"
      ]
    },
    "color": {
      "type": "string"
    },
    "visual_style": {
      "type": "string"
    },
    "personality_traits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "voice": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "age": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "clothing": {
      "type": "string"
    },
    "emotions": {
      "type": "string"
    },
    "speech_style": {
      "type": "string"
    },
    "reference_image_url": {
      "type": "string"
    },
    "share_enabled": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.share_enabled": true
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}