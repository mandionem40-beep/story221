{
  "name": "Report",
  "type": "object",
  "properties": {
    "reel_id": {
      "type": "string"
    },
    "comment_id": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "resolved",
        "dismissed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "reason"
  ]
}