{
  "name": "ReferralClick",
  "type": "object",
  "properties": {
    "referral_code": {
      "type": "string"
    },
    "referrer_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "referral_code"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.referrer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}