{
  "name": "Reel",
  "type": "object",
  "properties": {
    "generation_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "video",
        "image",
        "story"
      ]
    },
    "views": {
      "type": "integer",
      "default": 0
    },
    "trending_score": {
      "type": "number",
      "default": 0
    },
    "author_name": {
      "type": "string"
    },
    "author_avatar": {
      "type": "string"
    },
    "influencer_id": {
      "type": "string"
    },
    "share_count": {
      "type": "integer",
      "default": 0
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "generation_id",
    "title"
  ],
  "rls": {
    "create": true,
    "read": true,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}